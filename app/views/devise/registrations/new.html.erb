<% content_for :title, "Sign Up - Authlift" %>
<% content_for :container_class, "flex min-h-screen items-center justify-center px-4 py-12 sm:px-6 lg:px-8" %>

<div class="w-full max-w-md space-y-8">
  <!-- Logo & Header -->
  <div class="text-center">
    <svg class="mx-auto h-12 w-12 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
    </svg>
    <h2 class="mt-6 text-3xl font-bold tracking-tight text-gray-900">
      Create your account
    </h2>
    <p class="mt-2 text-sm text-gray-600">
      Already have an account?
      <%= link_to "Sign in", new_user_session_path, class: "font-medium text-blue-600 hover:text-blue-500" %>
    </p>
  </div>

  <%= render ::UI::CardComponent.new(shadow: true) do |card| %>
    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "space-y-6" }, data: { turbo: false }) do |f| %>
      <%= render ::Shared::FormErrorsComponent.new(model: resource) %>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <%= f.label :first_name, "First name", class: "block text-sm font-medium text-gray-700" %>
          <div class="mt-1">
            <%= f.text_field :first_name, autofocus: true, required: true,
                class: "block w-full appearance-none rounded-lg border border-gray-300 px-3 py-2 placeholder-gray-400 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-blue-500 sm:text-sm" %>
          </div>
        </div>

        <div>
          <%= f.label :last_name, "Last name", class: "block text-sm font-medium text-gray-700" %>
          <div class="mt-1">
            <%= f.text_field :last_name, required: true,
                class: "block w-full appearance-none rounded-lg border border-gray-300 px-3 py-2 placeholder-gray-400 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-blue-500 sm:text-sm" %>
          </div>
        </div>
      </div>

      <div>
        <%= f.label :email, "Email address", class: "block text-sm font-medium text-gray-700" %>
        <div class="mt-1">
          <%= f.email_field :email, autocomplete: "email", required: true,
              class: "block w-full appearance-none rounded-lg border border-gray-300 px-3 py-2 placeholder-gray-400 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-blue-500 sm:text-sm" %>
        </div>
      </div>

      <div>
        <%= f.label :password, class: "block text-sm font-medium text-gray-700" %>
        <div class="mt-1">
          <%= f.password_field :password, autocomplete: "new-password", required: true,
              class: "block w-full appearance-none rounded-lg border border-gray-300 px-3 py-2 placeholder-gray-400 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-blue-500 sm:text-sm" %>
        </div>
        <p class="mt-1 text-xs text-gray-500">Minimum 6 characters</p>
      </div>

      <div>
        <%= f.label :password_confirmation, "Confirm password", class: "block text-sm font-medium text-gray-700" %>
        <div class="mt-1">
          <%= f.password_field :password_confirmation, autocomplete: "new-password", required: true,
              class: "block w-full appearance-none rounded-lg border border-gray-300 px-3 py-2 placeholder-gray-400 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-blue-500 sm:text-sm" %>
        </div>
      </div>

      <div>
        <%= f.submit "Create account", class: "w-full flex justify-center py-2 px-4 border border-transparent rounded-lg shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors" %>
      </div>
    <% end %>

    <!-- Social Signup -->
    <div class="mt-6">
      <div class="relative">
        <div class="absolute inset-0 flex items-center">
          <div class="w-full border-t border-gray-300"></div>
        </div>
        <div class="relative flex justify-center text-sm">
          <span class="bg-white px-2 text-gray-500">Or sign up with</span>
        </div>
      </div>

      <div class="mt-6">
        <%= link_to user_google_oauth2_omniauth_authorize_path, class: "w-full inline-flex justify-center py-2 px-4 border border-gray-300 rounded-lg shadow-sm bg-white text-sm font-medium text-gray-500 hover:bg-gray-50 transition-colors", data: { turbo: false } do %>
          <svg class="w-5 h-5" viewBox="0 0 24 24">
            <path fill="currentColor" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
            <path fill="currentColor" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
            <path fill="currentColor" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
            <path fill="currentColor" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
          </svg>
          <span class="ml-2">Google</span>
        <% end %>
      </div>
    </div>

    <p class="mt-4 text-xs text-center text-gray-600">
      By creating an account, you agree to our
      <%= link_to "Terms of Service", "#", class: "text-blue-600 hover:text-blue-500" %>
      and
      <%= link_to "Privacy Policy", "#", class: "text-blue-600 hover:text-blue-500" %>
    </p>
  <% end %>
</div>
