<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Admin Panel - Authlift</title>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>
</head>

<body class="bg-gray-50">
  <div class="min-h-screen flex" data-controller="mobile-nav">
    <!-- Mobile sidebar backdrop -->
    <div class="hidden fixed inset-0 z-30 bg-black/50 lg:hidden"
         data-mobile-nav-target="backdrop"
         data-action="click->mobile-nav#close"></div>

    <!-- Sidebar: off-screen on mobile, fixed on desktop -->
    <aside class="fixed inset-y-0 left-0 z-40 w-64 bg-white border-r border-gray-200 overflow-y-auto -translate-x-full lg:translate-x-0 transition-transform duration-300 ease-in-out"
           data-mobile-nav-target="drawer">
      <!-- Logo/Brand -->
      <div class="p-6 border-b border-gray-200">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 bg-blue-600 rounded-lg flex items-center justify-center">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
            </svg>
          </div>
          <div>
            <h1 class="text-xl font-bold text-gray-900">Authlift</h1>
            <p class="text-xs text-gray-500">Admin Panel</p>
          </div>
        </div>
      </div>

      <!-- Navigation -->
      <nav class="p-4 space-y-1">
        <%= link_to root_path, class: "flex items-center gap-3 px-4 py-3 text-sm font-medium rounded-lg transition-colors border border-gray-200 text-gray-700 hover:bg-gray-50 mb-4", data: { action: "click->mobile-nav#close" } do %>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
          </svg>
          <span>Back to Dashboard</span>
        <% end %>

        <div class="pt-2 border-t border-gray-200">
          <%= link_to admin_root_path, class: "flex items-center gap-3 px-4 py-3 text-sm font-medium rounded-lg transition-colors #{current_page?(admin_root_path) ? 'bg-blue-50 text-blue-700' : 'text-gray-700 hover:bg-gray-100'}", data: { action: "click->mobile-nav#close" } do %>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
            </svg>
            <span>Dashboard</span>
          <% end %>
        </div>

        <%= link_to admin_users_path, class: "flex items-center gap-3 px-4 py-3 text-sm font-medium rounded-lg transition-colors #{controller_name == 'users' ? 'bg-blue-50 text-blue-700' : 'text-gray-700 hover:bg-gray-100'}", data: { action: "click->mobile-nav#close" } do %>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/>
          </svg>
          <span>Users</span>
        <% end %>

        <%= link_to admin_companies_path, class: "flex items-center gap-3 px-4 py-3 text-sm font-medium rounded-lg transition-colors #{controller_name == 'companies' ? 'bg-blue-50 text-blue-700' : 'text-gray-700 hover:bg-gray-100'}", data: { action: "click->mobile-nav#close" } do %>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
          </svg>
          <span>Companies</span>
        <% end %>

        <%= link_to admin_oauth_applications_path, class: "flex items-center gap-3 px-4 py-3 text-sm font-medium rounded-lg transition-colors #{controller_name == 'oauth_applications' ? 'bg-blue-50 text-blue-700' : 'text-gray-700 hover:bg-gray-100'}", data: { action: "click->mobile-nav#close" } do %>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/>
          </svg>
          <span>OAuth Apps</span>
        <% end %>

        <%= link_to admin_api_keys_path, class: "flex items-center gap-3 px-4 py-3 text-sm font-medium rounded-lg transition-colors #{controller_name == 'api_keys' ? 'bg-blue-50 text-blue-700' : 'text-gray-700 hover:bg-gray-100'}", data: { action: "click->mobile-nav#close" } do %>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/>
          </svg>
          <span>API Keys</span>
        <% end %>
      </nav>

      <!-- User Info at Bottom -->
      <div class="absolute bottom-0 left-0 right-0 p-4 border-t border-gray-200 bg-white">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 bg-gray-200 rounded-full flex items-center justify-center">
            <span class="text-sm font-medium text-gray-600">
              <%= current_user.first_name[0] %><%= current_user.last_name[0] %>
            </span>
          </div>
          <div class="flex-1 min-w-0">
            <p class="text-sm font-medium text-gray-900 truncate">
              <%= current_user.full_name %>
            </p>
            <p class="text-xs text-gray-500 truncate"><%= current_user.email %></p>
          </div>
        </div>
        <div class="mt-3 flex gap-2">
          <%= link_to "Exit Admin", root_path, class: "flex-1 px-3 py-2 text-xs font-medium text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition-colors text-center" %>
          <%= button_to "Sign Out", destroy_user_session_path, method: :delete, class: "flex-1 px-3 py-2 text-xs font-medium text-red-700 bg-red-50 rounded-lg hover:bg-red-100 transition-colors" %>
        </div>
      </div>
    </aside>

    <!-- Main Content -->
    <div class="flex-1 lg:ml-64">
      <!-- Top Bar -->
      <header class="bg-white border-b border-gray-200 sticky top-0 z-10">
        <div class="px-4 lg:px-8 py-4">
          <div class="flex items-center justify-between">
            <div class="flex items-center">
              <!-- Mobile hamburger for admin sidebar -->
              <button type="button"
                      class="lg:hidden p-2 rounded-md text-gray-400 hover:text-gray-500 hover:bg-gray-100 mr-3"
                      data-action="click->mobile-nav#open"
                      aria-label="Open sidebar">
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                </svg>
              </button>

              <!-- Breadcrumbs -->
              <nav class="flex items-center gap-2 text-sm">
                <%= link_to "Admin", admin_root_path, class: "text-gray-500 hover:text-gray-700" %>
                <% if controller_name != 'dashboard' %>
                  <span class="text-gray-400">/</span>
                  <span class="text-gray-900 font-medium"><%= controller_name.humanize %></span>
                  <% if action_name != 'index' %>
                    <span class="text-gray-400">/</span>
                    <span class="text-gray-900"><%= action_name.humanize %></span>
                  <% end %>
                <% end %>
              </nav>
            </div>

            <!-- Admin Badge -->
            <div class="flex items-center gap-3">
              <span class="px-3 py-1 text-xs font-semibold text-blue-700 bg-blue-100 rounded-full">
                Super Admin
              </span>
            </div>
          </div>
        </div>
      </header>

      <!-- Page Content -->
      <main class="p-4 lg:p-8">
        <!-- Flash Messages -->
        <% if flash[:notice] %>
          <div class="mb-6 p-4 bg-green-50 border border-green-200 rounded-lg">
            <div class="flex items-center gap-2">
              <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
              <p class="text-sm font-medium text-green-800"><%= flash[:notice] %></p>
            </div>
          </div>
        <% end %>

        <% if flash[:alert] %>
          <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded-lg">
            <div class="flex items-center gap-2">
              <svg class="w-5 h-5 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
              <p class="text-sm font-medium text-red-800"><%= flash[:alert] %></p>
            </div>
          </div>
        <% end %>

        <%= yield %>
      </main>
    </div>
  </div>
</body>
</html>
