<% content_for :title, "Dashboard - Authlift" %>

<div class="space-y-8">
  <!-- Welcome Section -->
  <div class="bg-gradient-to-r from-blue-600 to-blue-700 rounded-lg shadow-lg overflow-hidden">
    <div class="px-6 py-8 sm:px-8">
      <div class="flex items-center">
        <div class="flex-shrink-0">
          <div class="h-16 w-16 rounded-full bg-white bg-opacity-20 flex items-center justify-center">
            <svg class="h-8 w-8 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
          </div>
        </div>
        <div class="ml-6">
          <h1 class="text-3xl font-bold text-white">
            Welcome back, <%= current_user.first_name %>!
          </h1>
          <p class="mt-1 text-blue-100">
            Manage your OAuth applications and company settings
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- Current Company Card -->
  <% if current_user.current_company %>
    <%= render ::UI::CardComponent.new(shadow: true) do |card| %>
      <% card.with_header do %>
        <div class="flex items-center justify-between">
          <h2 class="text-lg font-semibold text-gray-900">Current Company</h2>
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
            Active
          </span>
        </div>
      <% end %>

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
        <div>
          <h3 class="text-sm font-medium text-gray-500">Company Name</h3>
          <p class="mt-1 text-lg font-semibold text-gray-900"><%= current_user.current_company.name %></p>
        </div>

        <div>
          <h3 class="text-sm font-medium text-gray-500">Company Code</h3>
          <p class="mt-1 text-lg font-mono text-gray-900"><%= current_user.current_company.code %></p>
        </div>

        <% if current_user.current_company.vat_id.present? %>
          <div>
            <h3 class="text-sm font-medium text-gray-500">VAT ID</h3>
            <p class="mt-1 text-base text-gray-900"><%= current_user.current_company.vat_id %></p>
          </div>
        <% end %>

        <% if current_user.current_company.email.present? %>
          <div>
            <h3 class="text-sm font-medium text-gray-500">Company Email</h3>
            <p class="mt-1 text-base text-gray-900"><%= current_user.current_company.email %></p>
          </div>
        <% end %>
      </div>

      <% if current_user.current_membership %>
        <div class="mt-6 pt-6 border-t border-gray-200">
          <h3 class="text-sm font-medium text-gray-500 mb-3">Your Role</h3>
          <div class="flex items-center space-x-2">
            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-blue-100 text-blue-800">
              <%= current_user.current_membership.role.titleize %>
            </span>
            <% if current_user.current_membership.scopes.any? %>
              <span class="text-sm text-gray-500">
                • <%= current_user.current_membership.scopes.count %> permissions
              </span>
            <% end %>
          </div>
        </div>
      <% end %>
    <% end %>
  <% end %>

  <!-- All Companies -->
  <% if current_user.companies.count > 1 %>
    <%= render ::UI::CardComponent.new(shadow: true) do |card| %>
      <% card.with_header do %>
        <h2 class="text-lg font-semibold text-gray-900">Your Companies</h2>
      <% end %>

      <div class="divide-y divide-gray-200">
        <% current_user.companies.each do |company| %>
          <div class="py-4 flex items-center justify-between">
            <div class="flex items-center space-x-4">
              <div class="flex-shrink-0">
                <div class="h-10 w-10 rounded-lg bg-blue-100 flex items-center justify-center">
                  <svg class="h-6 w-6 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                  </svg>
                </div>
              </div>
              <div>
                <p class="text-sm font-medium text-gray-900"><%= company.name %></p>
                <p class="text-sm text-gray-500"><%= company.code %></p>
              </div>
            </div>

            <% if company == current_user.current_company %>
              <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-green-100 text-green-800">
                <svg class="mr-1.5 h-4 w-4" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                </svg>
                Current
              </span>
            <% else %>
              <%= button_to "Switch", switch_company_path(company), method: :post, data: { turbo: false },
                  class: "inline-flex items-center px-3 py-1 border border-gray-300 rounded-lg text-xs font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors" %>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>
  <% end %>

  <!-- OAuth Applications -->
  <% if current_user.current_company %>
    <%= render ::UI::CardComponent.new(shadow: true) do |card| %>
      <% card.with_header do %>
        <div class="flex items-center justify-between">
          <h2 class="text-lg font-semibold text-gray-900">OAuth Applications</h2>
          <% if current_user.admin? || current_user.current_membership&.owner? %>
            <%= link_to "New Application", admin_oauth_applications_path, class: "inline-flex items-center px-3 py-1.5 border border-transparent text-sm font-medium rounded-lg text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors" %>
          <% end %>
        </div>
      <% end %>

      <% if current_user.current_company.oauth_applications.any? %>
        <div class="divide-y divide-gray-200">
          <% current_user.current_company.oauth_applications.limit(5).each do |app| %>
            <div class="py-4 flex items-center justify-between">
              <div class="flex items-center space-x-4">
                <div class="flex-shrink-0">
                  <% if app.application_icon.present? %>
                    <%= image_tag app.application_icon, class: "h-10 w-10 rounded-lg" %>
                  <% else %>
                    <div class="h-10 w-10 rounded-lg bg-gray-100 flex items-center justify-center">
                      <svg class="h-6 w-6 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                      </svg>
                    </div>
                  <% end %>
                </div>
                <div>
                  <p class="text-sm font-medium text-gray-900"><%= app.name %></p>
                  <p class="text-xs text-gray-500 font-mono"><%= app.uid %></p>
                </div>
              </div>

              <div class="flex items-center space-x-2">
                <% if app.trusted? %>
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                    Trusted
                  </span>
                <% end %>
                <%= link_to "View", admin_oauth_application_path(app), class: "text-sm font-medium text-blue-600 hover:text-blue-500" %>
              </div>
            </div>
          <% end %>
        </div>

        <% if current_user.current_company.oauth_applications.count > 5 %>
          <div class="mt-4 pt-4 border-t border-gray-200">
            <%= link_to "View all applications →", admin_oauth_applications_path, class: "text-sm font-medium text-blue-600 hover:text-blue-500" %>
          </div>
        <% end %>
      <% else %>
        <div class="text-center py-8">
          <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          <h3 class="mt-2 text-sm font-medium text-gray-900">No applications</h3>
          <p class="mt-1 text-sm text-gray-500">Get started by creating a new OAuth application.</p>
          <% if current_user.admin? || current_user.current_membership&.owner? %>
            <div class="mt-6">
              <%= link_to "New Application", admin_oauth_applications_path, class: "inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-lg text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" %>
            </div>
          <% end %>
        </div>
      <% end %>
    <% end %>
  <% end %>

  <!-- Quick Stats -->
  <div class="grid grid-cols-1 gap-5 sm:grid-cols-3">
    <%= render ::UI::CardComponent.new(shadow: true) do |card| %>
      <div class="flex items-center">
        <div class="flex-shrink-0">
          <div class="flex items-center justify-center h-12 w-12 rounded-md bg-blue-500 text-white">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
            </svg>
          </div>
        </div>
        <div class="ml-5 w-0 flex-1">
          <dl>
            <dt class="text-sm font-medium text-gray-500 truncate">Companies</dt>
            <dd class="text-2xl font-semibold text-gray-900"><%= current_user.companies.count %></dd>
          </dl>
        </div>
      </div>
    <% end %>

    <%= render ::UI::CardComponent.new(shadow: true) do |card| %>
      <div class="flex items-center">
        <div class="flex-shrink-0">
          <div class="flex items-center justify-center h-12 w-12 rounded-md bg-green-500 text-white">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
          </div>
        </div>
        <div class="ml-5 w-0 flex-1">
          <dl>
            <dt class="text-sm font-medium text-gray-500 truncate">Applications</dt>
            <dd class="text-2xl font-semibold text-gray-900">
              <%= current_user.current_company&.oauth_applications&.count || 0 %>
            </dd>
          </dl>
        </div>
      </div>
    <% end %>

    <%= render ::UI::CardComponent.new(shadow: true) do |card| %>
      <div class="flex items-center">
        <div class="flex-shrink-0">
          <div class="flex items-center justify-center h-12 w-12 rounded-md bg-purple-500 text-white">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
          </div>
        </div>
        <div class="ml-5 w-0 flex-1">
          <dl>
            <dt class="text-sm font-medium text-gray-500 truncate">Partnerships</dt>
            <dd class="text-2xl font-semibold text-gray-900">
              <%= (current_user.current_company&.owned_partnerships&.count || 0) + (current_user.current_company&.client_partnerships&.count || 0) %>
            </dd>
          </dl>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Quick Actions - Role-Based Navigation -->
  <% if current_user.super_admin? %>
    <!-- Super Admin Quick Actions -->
    <%= render ::UI::CardComponent.new(shadow: true) do |card| %>
      <% card.with_header do %>
        <div class="flex items-center justify-between">
          <div class="flex items-center space-x-2">
            <div class="h-8 w-8 rounded-lg bg-blue-100 flex items-center justify-center">
              <svg class="h-5 w-5 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <h2 class="text-lg font-semibold text-gray-900">Platform Administration</h2>
          </div>
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
            Super Admin
          </span>
        </div>
      <% end %>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <%= link_to admin_root_path, class: "p-4 border border-gray-200 rounded-lg hover:border-blue-300 hover:bg-blue-50 transition-all group" do %>
          <div class="flex items-center space-x-3">
            <div class="flex-shrink-0">
              <svg class="h-8 w-8 text-gray-400 group-hover:text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
              </svg>
            </div>
            <div class="flex-1 min-w-0">
              <p class="text-sm font-medium text-gray-900">Admin Dashboard</p>
              <p class="text-xs text-gray-500">Platform overview</p>
            </div>
          </div>
        <% end %>

        <%= link_to admin_users_path, class: "p-4 border border-gray-200 rounded-lg hover:border-blue-300 hover:bg-blue-50 transition-all group" do %>
          <div class="flex items-center space-x-3">
            <div class="flex-shrink-0">
              <svg class="h-8 w-8 text-gray-400 group-hover:text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
              </svg>
            </div>
            <div class="flex-1 min-w-0">
              <p class="text-sm font-medium text-gray-900">Users</p>
              <p class="text-xs text-gray-500">Manage all users</p>
            </div>
          </div>
        <% end %>

        <%= link_to admin_companies_path, class: "p-4 border border-gray-200 rounded-lg hover:border-blue-300 hover:bg-blue-50 transition-all group" do %>
          <div class="flex items-center space-x-3">
            <div class="flex-shrink-0">
              <svg class="h-8 w-8 text-gray-400 group-hover:text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
              </svg>
            </div>
            <div class="flex-1 min-w-0">
              <p class="text-sm font-medium text-gray-900">Companies</p>
              <p class="text-xs text-gray-500">Manage all companies</p>
            </div>
          </div>
        <% end %>

        <%= link_to admin_oauth_applications_path, class: "p-4 border border-gray-200 rounded-lg hover:border-blue-300 hover:bg-blue-50 transition-all group" do %>
          <div class="flex items-center space-x-3">
            <div class="flex-shrink-0">
              <svg class="h-8 w-8 text-gray-400 group-hover:text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
              </svg>
            </div>
            <div class="flex-1 min-w-0">
              <p class="text-sm font-medium text-gray-900">OAuth Apps</p>
              <p class="text-xs text-gray-500">All applications</p>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  <% elsif current_user.current_company && current_user.admin_for?(current_user.current_company) %>
    <!-- Company Admin/Owner Quick Actions -->
    <%= render ::UI::CardComponent.new(shadow: true) do |card| %>
      <% card.with_header do %>
        <div class="flex items-center justify-between">
          <div class="flex items-center space-x-2">
            <div class="h-8 w-8 rounded-lg bg-green-100 flex items-center justify-center">
              <svg class="h-5 w-5 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
              </svg>
            </div>
            <h2 class="text-lg font-semibold text-gray-900">Company Management</h2>
          </div>
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
            <%= current_user.current_membership.role.titleize %>
          </span>
        </div>
      <% end %>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        <%= link_to edit_admin_company_path(current_user.current_company), class: "p-4 border border-gray-200 rounded-lg hover:border-green-300 hover:bg-green-50 transition-all group" do %>
          <div class="flex items-center space-x-3">
            <div class="flex-shrink-0">
              <svg class="h-8 w-8 text-gray-400 group-hover:text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <div class="flex-1 min-w-0">
              <p class="text-sm font-medium text-gray-900">Company Settings</p>
              <p class="text-xs text-gray-500">Edit company info</p>
            </div>
          </div>
        <% end %>

        <%= link_to admin_company_memberships_path(current_user.current_company), class: "p-4 border border-gray-200 rounded-lg hover:border-green-300 hover:bg-green-50 transition-all group" do %>
          <div class="flex items-center space-x-3">
            <div class="flex-shrink-0">
              <svg class="h-8 w-8 text-gray-400 group-hover:text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
              </svg>
            </div>
            <div class="flex-1 min-w-0">
              <p class="text-sm font-medium text-gray-900">Team Members</p>
              <p class="text-xs text-gray-500">Manage memberships</p>
            </div>
          </div>
        <% end %>

        <%= link_to admin_company_partnerships_path(current_user.current_company), class: "p-4 border border-gray-200 rounded-lg hover:border-green-300 hover:bg-green-50 transition-all group" do %>
          <div class="flex items-center space-x-3">
            <div class="flex-shrink-0">
              <svg class="h-8 w-8 text-gray-400 group-hover:text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            </div>
            <div class="flex-1 min-w-0">
              <p class="text-sm font-medium text-gray-900">Partnerships</p>
              <p class="text-xs text-gray-500">B2B relationships</p>
            </div>
          </div>
        <% end %>

        <%= link_to admin_oauth_applications_path, class: "p-4 border border-gray-200 rounded-lg hover:border-green-300 hover:bg-green-50 transition-all group" do %>
          <div class="flex items-center space-x-3">
            <div class="flex-shrink-0">
              <svg class="h-8 w-8 text-gray-400 group-hover:text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
              </svg>
            </div>
            <div class="flex-1 min-w-0">
              <p class="text-sm font-medium text-gray-900">OAuth Applications</p>
              <p class="text-xs text-gray-500">Manage apps</p>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  <% end %>

  <!-- Self-Service Quick Actions (for all users) -->
  <%= render ::UI::CardComponent.new(shadow: true) do |card| %>
    <% card.with_header do %>
      <div class="flex items-center space-x-2">
        <div class="h-8 w-8 rounded-lg bg-gray-100 flex items-center justify-center">
          <svg class="h-5 w-5 text-gray-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
          </svg>
        </div>
        <h2 class="text-lg font-semibold text-gray-900">My Account</h2>
      </div>
    <% end %>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      <%= link_to edit_user_registration_path, class: "p-4 border border-gray-200 rounded-lg hover:border-gray-300 hover:bg-gray-50 transition-all group" do %>
        <div class="flex items-center space-x-3">
          <div class="flex-shrink-0">
            <svg class="h-8 w-8 text-gray-400 group-hover:text-gray-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.121 17.804A13.937 13.937 0 0112 16c2.5 0 4.847.655 6.879 1.804M15 10a3 3 0 11-6 0 3 3 0 016 0zm6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <div class="flex-1 min-w-0">
            <p class="text-sm font-medium text-gray-900">Profile Settings</p>
            <p class="text-xs text-gray-500">Update your info</p>
          </div>
        </div>
      <% end %>

      <%= link_to edit_user_registration_path, class: "p-4 border border-gray-200 rounded-lg hover:border-gray-300 hover:bg-gray-50 transition-all group" do %>
        <div class="flex items-center space-x-3">
          <div class="flex-shrink-0">
            <svg class="h-8 w-8 text-gray-400 group-hover:text-gray-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />
            </svg>
          </div>
          <div class="flex-1 min-w-0">
            <p class="text-sm font-medium text-gray-900">Change Password</p>
            <p class="text-xs text-gray-500">Update password</p>
          </div>
        </div>
      <% end %>

      <%= link_to authorized_applications_path, class: "p-4 border border-gray-200 rounded-lg hover:border-gray-300 hover:bg-gray-50 transition-all group" do %>
        <div class="flex items-center space-x-3">
          <div class="flex-shrink-0">
            <svg class="h-8 w-8 text-gray-400 group-hover:text-gray-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
          <div class="flex-1 min-w-0">
            <p class="text-sm font-medium text-gray-900">Authorized Apps</p>
            <p class="text-xs text-gray-500">Manage access</p>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
