<% content_for :title, "Authorized Applications - Authlift" %>

<div class="space-y-6">
  <div>
    <h1 class="text-2xl font-bold text-gray-900"><%= t("doorkeeper.authorized_applications.index.title") %></h1>
    <p class="mt-1 text-sm text-gray-500">
      These applications have been granted access to your account. You can revoke access at any time.
    </p>
  </div>

  <% if @authorized_apps.any? %>
    <div class="space-y-4">
      <% @authorized_apps.each do |app| %>
        <%= render ::UI::CardComponent.new(shadow: true) do |card| %>
          <div class="flex items-center justify-between">
            <div class="flex items-center space-x-4">
              <div class="flex-shrink-0">
                <% if app.application_icon.present? %>
                  <%= image_tag app.application_icon, class: "h-12 w-12 rounded-lg" %>
                <% else %>
                  <div class="h-12 w-12 rounded-lg bg-blue-100 flex items-center justify-center">
                    <svg class="h-6 w-6 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
                    </svg>
                  </div>
                <% end %>
              </div>

              <div>
                <h3 class="text-base font-semibold text-gray-900"><%= app.name %></h3>
                <% if app.home.present? %>
                  <p class="text-sm text-gray-500"><%= app.home %></p>
                <% end %>

                <div class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-gray-500">
                  <% if app.token_scopes.present? %>
                    <span>
                      Scopes: <span class="font-mono"><%= app.token_scopes %></span>
                    </span>
                  <% end %>
                  <span>
                    First authorized: <%= app.first_authorized_at.strftime("%b %d, %Y") %>
                  </span>
                  <span>
                    Last used: <%= app.last_authorized_at.strftime("%b %d, %Y") %>
                  </span>
                  <span>
                    <%= pluralize(app.active_token_count, "active token") %>
                  </span>
                </div>
              </div>
            </div>

            <div class="flex-shrink-0 ml-4">
              <%= button_to t("doorkeeper.authorized_applications.buttons.revoke"),
                    authorized_application_path(app),
                    method: :delete,
                    data: { turbo_confirm: t("doorkeeper.authorized_applications.confirmations.revoke") },
                    class: "inline-flex items-center px-4 py-2 border border-red-300 rounded-lg text-sm font-medium text-red-700 bg-white hover:bg-red-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500 transition-colors" %>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <%= render ::UI::CardComponent.new(shadow: true) do %>
      <div class="text-center py-8">
        <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
        </svg>
        <h3 class="mt-2 text-sm font-medium text-gray-900">No authorized applications</h3>
        <p class="mt-1 text-sm text-gray-500">
          When you authorize an OAuth application, it will appear here.
        </p>
      </div>
    <% end %>
  <% end %>

  <div class="text-center">
    <%= link_to "Back to Dashboard", dashboard_path, class: "text-sm font-medium text-blue-600 hover:text-blue-500" %>
  </div>
</div>
