<%= form_with model: customer_group, url: url, method: method, class: "space-y-6", data: { turbo: false } do |f| %>
  <!-- Error Messages -->
  <% if customer_group.errors.any? %>
    <div class="p-4 bg-red-50 border border-red-200 rounded-lg">
      <div class="flex items-start gap-2">
        <svg class="w-5 h-5 text-red-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        <div>
          <h3 class="text-sm font-medium text-red-800"><%= pluralize(customer_group.errors.count, "error") %> prohibited this customer group from being saved:</h3>
          <ul class="mt-2 text-sm text-red-700 list-disc list-inside">
            <% customer_group.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      </div>
    </div>
  <% end %>

  <!-- Basic Info -->
  <div class="space-y-4">
    <h3 class="text-sm font-medium text-gray-700 uppercase tracking-wider">Basic Information</h3>

    <div>
      <%= f.label :name, "Group Name", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= f.text_field :name, class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500", placeholder: "e.g. Premium Wholesale" %>
    </div>

    <div>
      <%= f.label :group_type, "Group Type", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= f.select :group_type,
          options_for_select([["Wholesale", "wholesale"], ["Retail", "retail"], ["VIP", "vip"], ["Partner", "partner"]], customer_group.group_type),
          { prompt: "Select a type..." },
          class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
    </div>

    <div class="flex items-start">
      <div class="flex items-center h-5">
        <%= f.check_box :enabled, class: "h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 rounded" %>
      </div>
      <div class="ml-3">
        <%= f.label :enabled, "Enabled", class: "font-medium text-gray-700" %>
        <p class="text-sm text-gray-500">Enable this customer group for use in pricing and product access</p>
      </div>
    </div>
  </div>

  <!-- Pricing Rules -->
  <div class="space-y-4 pt-4 border-t border-gray-200">
    <h3 class="text-sm font-medium text-gray-700 uppercase tracking-wider">Pricing Rules</h3>
    <p class="text-sm text-gray-500">Configure how prices are calculated for this group. Multiplier is applied first, then discount.</p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <label for="customer_group_price_multiplier" class="block text-sm font-medium text-gray-700 mb-2">Price Multiplier</label>
        <input type="number" name="customer_group[price_multiplier]" id="customer_group_price_multiplier"
               value="<%= customer_group.pricing_rules&.dig("price_multiplier") || 1.0 %>"
               step="0.01" min="0"
               class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
        <p class="mt-1 text-sm text-gray-500">1.0 = standard price, 1.5 = 50% markup, 0.8 = 20% less</p>
      </div>

      <div>
        <label for="customer_group_discount_percentage" class="block text-sm font-medium text-gray-700 mb-2">Discount Percentage</label>
        <input type="number" name="customer_group[discount_percentage]" id="customer_group_discount_percentage"
               value="<%= customer_group.pricing_rules&.dig("discount_percentage") || 0 %>"
               step="0.1" min="0" max="100"
               class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
        <p class="mt-1 text-sm text-gray-500">Applied after multiplier. 0 = no discount, 20 = 20% off</p>
      </div>
    </div>
  </div>

  <!-- Product Restriction Rules -->
  <div class="space-y-4 pt-4 border-t border-gray-200">
    <h3 class="text-sm font-medium text-gray-700 uppercase tracking-wider">Product Restrictions</h3>
    <p class="text-sm text-gray-500">Control which products this group can access. Leave both empty for unrestricted access.</p>

    <div>
      <label for="customer_group_allowed_product_ids" class="block text-sm font-medium text-gray-700 mb-2">Allowed Product IDs</label>
      <textarea name="customer_group[allowed_product_ids]" id="customer_group_allowed_product_ids"
                rows="3"
                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                placeholder="e.g. SKU-001, SKU-002, SKU-003"><%= customer_group.product_restriction_rules&.dig("allowed_product_ids")&.join(", ") %></textarea>
      <p class="mt-1 text-sm text-gray-500">Comma-separated list. If set, only these products are accessible.</p>
    </div>

    <div>
      <label for="customer_group_excluded_product_ids" class="block text-sm font-medium text-gray-700 mb-2">Excluded Product IDs</label>
      <textarea name="customer_group[excluded_product_ids]" id="customer_group_excluded_product_ids"
                rows="3"
                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                placeholder="e.g. SKU-100, SKU-200"><%= customer_group.product_restriction_rules&.dig("excluded_product_ids")&.join(", ") %></textarea>
      <p class="mt-1 text-sm text-gray-500">Comma-separated list. These products are always blocked for this group.</p>
    </div>
  </div>

  <!-- Actions -->
  <div class="flex items-center justify-end gap-3 pt-4 border-t border-gray-200">
    <%= link_to "Cancel", admin_company_customer_groups_path(@company), class: "px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors" %>
    <%= f.submit submit_label, class: "px-4 py-2 text-sm font-medium text-white bg-blue-600 border border-transparent rounded-lg hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors cursor-pointer" %>
  </div>
<% end %>
