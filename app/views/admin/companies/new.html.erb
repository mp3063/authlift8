<div class="space-y-6">
  <!-- Page Header -->
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-3xl font-bold text-gray-900">New Company</h1>
      <p class="mt-2 text-gray-600">Create a new company in the system</p>
    </div>
    <%= link_to admin_companies_path, class: "px-4 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition-colors font-medium" do %>
      Cancel
    <% end %>
  </div>

  <!-- Create Form -->
  <%= render ::UI::CardComponent.new(shadow: true) do |card| %>
    <% card.with_header do %>
      <h2 class="text-lg font-semibold text-gray-900">Company Information</h2>
    <% end %>

    <div class="p-6">
      <%= render 'form', company: @company %>
    </div>
  <% end %>
</div>
