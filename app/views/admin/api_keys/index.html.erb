<div class="space-y-6">
  <!-- Page Header -->
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-3xl font-bold text-gray-900">API Keys</h1>
      <p class="mt-2 text-gray-600">Manage API keys for company integrations</p>
    </div>
    <%= link_to new_admin_api_key_path, class: "px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors font-medium" do %>
      + New API Key
    <% end %>
  </div>

  <!-- Search & Filters -->
  <%= render ::UI::CardComponent.new(shadow: true) do |card| %>
    <div class="p-6">
      <%= form_with url: admin_api_keys_path, method: :get, class: "flex gap-4" do |form| %>
        <div class="flex-1">
          <%= form.text_field :search,
              value: params[:search],
              placeholder: "Search by name...",
              class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
        </div>
        <div class="flex items-center gap-4">
          <label class="flex items-center gap-2">
            <%= form.check_box :active_only, { checked: params[:active_only] == '1', class: "rounded border-gray-300 text-blue-600 focus:ring-blue-500" }, '1', '0' %>
            <span class="text-sm text-gray-700">Active Only</span>
          </label>
          <%= form.submit "Search", class: "px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors font-medium" %>
          <%= link_to "Clear", admin_api_keys_path, class: "px-6 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition-colors font-medium" %>
        </div>
      <% end %>
    </div>
  <% end %>

  <!-- API Keys Table -->
  <%= render ::UI::CardComponent.new(shadow: true) do |card| %>
    <% card.with_header do %>
      <div class="flex items-center justify-between">
        <h2 class="text-lg font-semibold text-gray-900">All API Keys (<%= @api_keys.count %>)</h2>
      </div>
    <% end %>

    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Name</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Company</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Token</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Scopes</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Last Used</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Created</th>
            <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% if @api_keys.any? %>
            <% @api_keys.each do |api_key| %>
              <tr class="hover:bg-gray-50 transition-colors">
                <td class="px-6 py-4 whitespace-nowrap">
                  <div class="text-sm font-medium text-gray-900"><%= api_key.name || 'Unnamed' %></div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <%= link_to api_key.company.name, admin_company_path(api_key.company), class: "text-sm text-blue-600 hover:text-blue-900" %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <code class="px-2 py-1 bg-gray-100 rounded text-xs font-mono"><%= "#{api_key.token[0..7]}...#{api_key.token[-4..-1]}" %></code>
                </td>
                <td class="px-6 py-4">
                  <% if api_key.scopes.present? && api_key.scopes.any? %>
                    <div class="flex flex-wrap gap-1">
                      <% api_key.scopes.first(3).each do |scope| %>
                        <span class="px-2 py-1 text-xs font-semibold text-purple-700 bg-purple-100 rounded-full"><%= scope %></span>
                      <% end %>
                      <% if api_key.scopes.count > 3 %>
                        <span class="px-2 py-1 text-xs font-semibold text-gray-700 bg-gray-100 rounded-full">+<%= api_key.scopes.count - 3 %></span>
                      <% end %>
                    </div>
                  <% else %>
                    <span class="text-xs text-gray-400">No scopes</span>
                  <% end %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <% if api_key.expired? %>
                    <span class="px-2 py-1 text-xs font-semibold text-red-700 bg-red-100 rounded-full">Expired</span>
                  <% elsif api_key.active %>
                    <span class="px-2 py-1 text-xs font-semibold text-green-700 bg-green-100 rounded-full">Active</span>
                  <% else %>
                    <span class="px-2 py-1 text-xs font-semibold text-gray-700 bg-gray-100 rounded-full">Inactive</span>
                  <% end %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                  <%= api_key.last_used_at ? api_key.last_used_at.strftime('%b %d, %Y') : 'Never' %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                  <%= api_key.created_at.strftime('%b %d, %Y') %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                  <div class="flex items-center justify-end gap-2">
                    <%= link_to "View", admin_api_key_path(api_key), class: "text-blue-600 hover:text-blue-900" %>
                    <span class="text-gray-300">|</span>
                    <%= link_to "Edit", edit_admin_api_key_path(api_key), class: "text-yellow-600 hover:text-yellow-900" %>
                    <span class="text-gray-300">|</span>
                    <%= button_to "Delete", admin_api_key_path(api_key),
                        method: :delete,
                        form: { data: { turbo_confirm: "Are you sure you want to delete this API key? This action cannot be undone." }, class: "inline" },
                        class: "text-red-600 hover:text-red-900" %>
                  </div>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="8" class="px-6 py-12 text-center">
                <div class="flex flex-col items-center">
                  <svg class="w-12 h-12 text-gray-400 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/>
                  </svg>
                  <p class="text-gray-500 text-sm">No API keys found</p>
                  <%= link_to "Create first API key", new_admin_api_key_path, class: "mt-4 px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors text-sm font-medium" %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
