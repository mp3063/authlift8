<div class="space-y-6">
  <!-- Page Header -->
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-3xl font-bold text-gray-900"><%= @api_key.name || 'API Key' %></h1>
      <p class="mt-2 text-gray-600">Company: <%= link_to @api_key.company.name, admin_company_path(@api_key.company), class: "text-blue-600 hover:text-blue-900" %></p>
    </div>
    <div class="flex gap-3">
      <%= link_to edit_admin_api_key_path(@api_key), class: "px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors font-medium" do %>
        Edit API Key
      <% end %>
      <%= link_to admin_api_keys_path, class: "px-4 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition-colors font-medium" do %>
        Back to API Keys
      <% end %>
    </div>
  </div>

  <!-- API Key Details -->
  <%= render ::UI::CardComponent.new(shadow: true) do |card| %>
    <% card.with_header do %>
      <h2 class="text-lg font-semibold text-gray-900">API Key Information</h2>
    <% end %>

    <div class="p-6">
      <dl class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <dt class="text-sm font-medium text-gray-500">Name</dt>
          <dd class="mt-1 text-sm text-gray-900"><%= @api_key.name || '-' %></dd>
        </div>

        <div>
          <dt class="text-sm font-medium text-gray-500">Company</dt>
          <dd class="mt-1 text-sm text-gray-900">
            <%= link_to @api_key.company.name, admin_company_path(@api_key.company), class: "text-blue-600 hover:text-blue-900" %>
          </dd>
        </div>

        <div class="md:col-span-2">
          <dt class="text-sm font-medium text-gray-500 mb-2">API Token</dt>
          <dd class="mt-1">
            <div class="flex items-center gap-2">
              <code id="api-token" class="flex-1 px-3 py-2 bg-gray-100 rounded text-xs font-mono border border-gray-300"><%= @api_key.token %></code>
              <button
                onclick="navigator.clipboard.writeText(document.getElementById('api-token').textContent); this.textContent = 'Copied!'; setTimeout(() => this.textContent = 'Copy', 2000)"
                class="px-3 py-2 bg-blue-600 text-white text-xs rounded-lg hover:bg-blue-700 transition-colors font-medium">
                Copy
              </button>
            </div>
            <p class="mt-2 text-xs text-yellow-700 bg-yellow-50 border border-yellow-200 rounded-lg p-3">
              <svg class="inline w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
              </svg>
              <strong>Security Warning:</strong> Store this token securely. Anyone with this token can access the API with the permissions granted to this key.
            </p>
          </dd>
        </div>

        <div>
          <dt class="text-sm font-medium text-gray-500">Status</dt>
          <dd class="mt-1">
            <% if @api_key.expired? %>
              <span class="px-2 py-1 text-xs font-semibold text-red-700 bg-red-100 rounded-full">Expired</span>
            <% elsif @api_key.active %>
              <span class="px-2 py-1 text-xs font-semibold text-green-700 bg-green-100 rounded-full">Active</span>
            <% else %>
              <span class="px-2 py-1 text-xs font-semibold text-gray-700 bg-gray-100 rounded-full">Inactive</span>
            <% end %>
          </dd>
        </div>

        <div>
          <dt class="text-sm font-medium text-gray-500">Valid Until</dt>
          <dd class="mt-1 text-sm text-gray-900">
            <%= @api_key.expires_at ? @api_key.expires_at.strftime('%B %d, %Y at %I:%M %p') : 'Never expires' %>
          </dd>
        </div>

        <div>
          <dt class="text-sm font-medium text-gray-500">Last Used At</dt>
          <dd class="mt-1 text-sm text-gray-900">
            <%= @api_key.last_used_at ? @api_key.last_used_at.strftime('%B %d, %Y at %I:%M %p') : 'Never used' %>
          </dd>
        </div>

        <div>
          <dt class="text-sm font-medium text-gray-500">Created At</dt>
          <dd class="mt-1 text-sm text-gray-900"><%= @api_key.created_at.strftime('%B %d, %Y at %I:%M %p') %></dd>
        </div>

        <div class="md:col-span-2">
          <dt class="text-sm font-medium text-gray-500 mb-2">Scopes (Permissions)</dt>
          <dd class="mt-1">
            <% if @api_key.scopes.present? && @api_key.scopes.any? %>
              <div class="flex flex-wrap gap-2">
                <% @api_key.scopes.each do |scope| %>
                  <span class="px-3 py-1 text-sm font-semibold text-purple-700 bg-purple-100 rounded-full"><%= scope %></span>
                <% end %>
              </div>
            <% else %>
              <span class="text-sm text-gray-400">No scopes assigned</span>
            <% end %>
          </dd>
        </div>
      </dl>
    </div>
  <% end %>

  <!-- Danger Zone -->
  <%= render ::UI::CardComponent.new(shadow: true) do |card| %>
    <% card.with_header do %>
      <h2 class="text-lg font-semibold text-red-600">Danger Zone</h2>
    <% end %>

    <div class="p-6">
      <div class="flex items-center justify-between">
        <div>
          <h3 class="text-sm font-medium text-gray-900">Delete API Key</h3>
          <p class="mt-1 text-sm text-gray-500">Permanently delete this API key. This action cannot be undone.</p>
        </div>
        <%= button_to "Delete API Key", admin_api_key_path(@api_key),
            method: :delete,
            form: { data: { turbo_confirm: "Are you sure you want to delete this API key? This action cannot be undone and will immediately revoke access." } },
            class: "px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 transition-colors font-medium" %>
      </div>
    </div>
  <% end %>
</div>
