<%= form_with model: [:admin, api_key], class: "space-y-6" do |form| %>
  <!-- Display Errors -->
  <% if api_key.errors.any? %>
    <div class="p-4 bg-red-50 border border-red-200 rounded-lg">
      <div class="flex items-start gap-2">
        <svg class="w-5 h-5 text-red-600 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        <div class="flex-1">
          <h3 class="text-sm font-medium text-red-800">
            <%= pluralize(api_key.errors.count, "error") %> prohibited this API key from being saved:
          </h3>
          <ul class="mt-2 text-sm text-red-700 list-disc list-inside">
            <% api_key.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      </div>
    </div>
  <% end %>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <!-- Name -->
    <div class="md:col-span-2">
      <%= form.label :name, class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= form.text_field :name,
          class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500",
          placeholder: "e.g., Production API Key",
          required: true %>
      <p class="mt-1 text-xs text-gray-500">A descriptive name to identify this API key</p>
    </div>

    <!-- Company -->
    <div>
      <%= form.label :company_id, "Company", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= form.select :company_id,
          options_for_select(@companies.map { |c| [c.name, c.id] }, api_key.company_id),
          { prompt: "Select a company" },
          class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500",
          required: true %>
    </div>

    <!-- Active Status -->
    <div class="flex items-center pt-7">
      <%= form.check_box :active,
          class: "rounded border-gray-300 text-blue-600 focus:ring-blue-500" %>
      <%= form.label :active, class: "ml-2 text-sm font-medium text-gray-700" %>
      <p class="ml-2 text-xs text-gray-500">(Enable or disable this API key)</p>
    </div>

    <!-- Expires At -->
    <div>
      <%= form.label :expires_at, "Expiration Date (Optional)", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= form.datetime_local_field :expires_at,
          value: api_key.expires_at&.strftime('%Y-%m-%dT%H:%M'),
          class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
      <p class="mt-1 text-xs text-gray-500">Leave blank for no expiration</p>
    </div>

    <!-- Token (only shown when editing) -->
    <% if api_key.persisted? %>
      <div>
        <%= form.label :token, "API Token", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <code class="block px-4 py-2 bg-gray-100 rounded-lg text-xs font-mono border border-gray-300"><%= api_key.token %></code>
        <p class="mt-1 text-xs text-gray-500">Token cannot be changed after creation</p>
      </div>
    <% end %>

    <!-- Scopes -->
    <div class="md:col-span-2">
      <%= form.label :scope_list, "Scopes (Permissions)", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= form.text_field :scope_list,
          value: api_key.persisted? ? (api_key.scopes || []).join(", ") : "",
          class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500",
          placeholder: "e.g., read:users, write:products, admin:companies" %>
      <p class="mt-1 text-xs text-gray-500">Comma-separated list of permission scopes for this API key</p>

      <!-- Suggested Scopes -->
      <div class="mt-3 p-3 bg-blue-50 border border-blue-200 rounded-lg">
        <p class="text-xs font-medium text-blue-900 mb-2">Common scopes:</p>
        <div class="flex flex-wrap gap-2">
          <% %w[read:users write:users read:companies write:companies read:products write:products admin:all].each do |scope| %>
            <button type="button"
                    onclick="addScope(this, '<%= scope %>')"
                    class="px-2 py-1 text-xs bg-white border border-blue-300 text-blue-700 rounded hover:bg-blue-100 transition-colors">
              + <%= scope %>
            </button>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Security Notice -->
  <% unless api_key.persisted? %>
    <div class="p-4 bg-yellow-50 border border-yellow-200 rounded-lg">
      <div class="flex items-start gap-2">
        <svg class="w-5 h-5 text-yellow-600 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
        </svg>
        <div class="flex-1">
          <h3 class="text-sm font-medium text-yellow-800">Security Notice</h3>
          <p class="mt-1 text-sm text-yellow-700">
            The API token will be generated automatically and displayed only once after creation.
            Make sure to copy and store it securely.
          </p>
        </div>
      </div>
    </div>
  <% end %>

  <!-- Form Actions -->
  <div class="flex items-center justify-end gap-3 pt-6 border-t border-gray-200">
    <%= link_to "Cancel", api_key.persisted? ? admin_api_key_path(api_key) : admin_api_keys_path, class: "px-6 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition-colors font-medium" %>
    <%= form.submit api_key.persisted? ? "Save Changes" : "Create API Key", class: "px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors font-medium" %>
  </div>
<% end %>

<script>
  function addScope(button, scope) {
    const input = document.getElementById('api_key_scope_list');
    const currentScopes = input.value.split(',').map(s => s.trim()).filter(s => s.length > 0);

    if (!currentScopes.includes(scope)) {
      currentScopes.push(scope);
      input.value = currentScopes.join(', ');
      button.classList.add('opacity-50', 'cursor-not-allowed');
      button.disabled = true;
    }
  }
</script>
