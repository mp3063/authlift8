<div class="space-y-6">
  <!-- Page Header -->
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-3xl font-bold text-gray-900">Edit API Key</h1>
      <p class="mt-2 text-gray-600">Update API key information</p>
    </div>
    <div class="flex gap-3">
      <%= link_to admin_api_key_path(@api_key), class: "px-4 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition-colors font-medium" do %>
        Cancel
      <% end %>
    </div>
  </div>

  <!-- Edit Form -->
  <%= render ::UI::CardComponent.new(shadow: true) do |card| %>
    <% card.with_header do %>
      <h2 class="text-lg font-semibold text-gray-900">API Key Information</h2>
    <% end %>

    <div class="p-6">
      <%= render 'form', api_key: @api_key %>
    </div>
  <% end %>
</div>
