<div class="space-y-6">
  <!-- Page Header -->
  <div>
    <h1 class="text-3xl font-bold text-gray-900">Edit Team Member</h1>
    <p class="mt-2 text-gray-600">Update membership for <%= @membership.user.full_name %> at <%= @company.name %></p>
  </div>

  <!-- Breadcrumb -->
  <nav class="flex items-center gap-2 text-sm">
    <%= link_to "Companies", admin_companies_path, class: "text-blue-600 hover:text-blue-700" %>
    <span class="text-gray-400">/</span>
    <%= link_to @company.name, admin_company_path(@company), class: "text-blue-600 hover:text-blue-700" %>
    <span class="text-gray-400">/</span>
    <%= link_to "Memberships", admin_company_memberships_path(@company), class: "text-blue-600 hover:text-blue-700" %>
    <span class="text-gray-400">/</span>
    <span class="text-gray-900">Edit</span>
  </nav>

  <!-- Form -->
  <%= render ::UI::CardComponent.new(shadow: true) do |card| %>
    <%= form_with model: @membership, url: admin_company_membership_path(@company, @membership), method: :patch, class: "space-y-6" do |f| %>
      <!-- Error Messages -->
      <% if @membership.errors.any? %>
        <div class="p-4 bg-red-50 border border-red-200 rounded-lg">
          <div class="flex items-start gap-2">
            <svg class="w-5 h-5 text-red-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <div>
              <h3 class="text-sm font-medium text-red-800"><%= pluralize(@membership.errors.count, "error") %> prohibited this membership from being saved:</h3>
              <ul class="mt-2 text-sm text-red-700 list-disc list-inside">
                <% @membership.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          </div>
        </div>
      <% end %>

      <!-- User (Read-only) -->
      <div>
        <%= f.label :user_id, "User", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <div class="flex items-center gap-3 p-4 bg-gray-50 rounded-lg border border-gray-200">
          <div class="w-10 h-10 bg-gray-300 rounded-full flex items-center justify-center">
            <span class="text-sm font-medium text-gray-600">
              <%= @membership.user.first_name[0] %><%= @membership.user.last_name[0] %>
            </span>
          </div>
          <div>
            <p class="text-sm font-medium text-gray-900"><%= @membership.user.full_name %></p>
            <p class="text-sm text-gray-500"><%= @membership.user.email %></p>
          </div>
        </div>
        <p class="mt-1 text-sm text-gray-500">User cannot be changed after membership creation</p>
      </div>

      <!-- Role -->
      <div>
        <%= f.label :role, "Role", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= f.select :role,
            [["Owner", "owner"], ["Admin", "admin"], ["Member", "member"]],
            {},
            class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
        <p class="mt-1 text-sm text-gray-500">
          <span class="font-medium">Owner:</span> Full access.
          <span class="font-medium">Admin:</span> Can manage company settings.
          <span class="font-medium">Member:</span> Basic access.
        </p>
      </div>

      <!-- Active Status -->
      <div class="flex items-start">
        <div class="flex items-center h-5">
          <%= f.check_box :active, class: "h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 rounded" %>
        </div>
        <div class="ml-3">
          <%= f.label :active, "Active", class: "font-medium text-gray-700" %>
          <p class="text-sm text-gray-500">Allow this user to access the company</p>
        </div>
      </div>

      <!-- Actions -->
      <div class="flex items-center justify-end gap-3 pt-4 border-t border-gray-200">
        <%= link_to "Cancel", admin_company_memberships_path(@company), class: "px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors" %>
        <%= f.submit "Update Member", class: "px-4 py-2 text-sm font-medium text-white bg-blue-600 border border-transparent rounded-lg hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors" %>
      </div>
    <% end %>
  <% end %>
</div>
