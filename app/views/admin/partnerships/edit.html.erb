<div class="space-y-6">
  <!-- Page Header -->
  <div>
    <h1 class="text-3xl font-bold text-gray-900">Edit Partnership</h1>
    <p class="mt-2 text-gray-600">Update partnership settings for <%= @company.name %></p>
  </div>

  <!-- Breadcrumb -->
  <nav class="flex items-center gap-2 text-sm">
    <%= link_to "Companies", admin_companies_path, class: "text-blue-600 hover:text-blue-700" %>
    <span class="text-gray-400">/</span>
    <%= link_to @company.name, admin_company_path(@company), class: "text-blue-600 hover:text-blue-700" %>
    <span class="text-gray-400">/</span>
    <%= link_to "Partnerships", admin_company_partnerships_path(@company), class: "text-blue-600 hover:text-blue-700" %>
    <span class="text-gray-400">/</span>
    <span class="text-gray-900">Edit</span>
  </nav>

  <!-- Form -->
  <%= render ::UI::CardComponent.new(shadow: true) do |card| %>
    <%= form_with model: @partnership, url: admin_company_partnership_path(@company, @partnership), method: :patch, class: "space-y-6", data: { turbo: false } do |f| %>
      <!-- Error Messages -->
      <% if @partnership.errors.any? %>
        <div class="p-4 bg-red-50 border border-red-200 rounded-lg">
          <div class="flex items-start gap-2">
            <svg class="w-5 h-5 text-red-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <div>
              <h3 class="text-sm font-medium text-red-800"><%= pluralize(@partnership.errors.count, "error") %> prohibited this partnership from being saved:</h3>
              <ul class="mt-2 text-sm text-red-700 list-disc list-inside">
                <% @partnership.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          </div>
        </div>
      <% end %>

      <!-- Partnership Info (Read-only) -->
      <div class="p-4 bg-gray-50 rounded-lg border border-gray-200 space-y-3">
        <h3 class="text-sm font-medium text-gray-700">Partnership Details</h3>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <p class="text-xs text-gray-500">Supplier/Owner</p>
            <p class="text-sm font-medium text-gray-900"><%= @partnership.partner_owner.name %></p>
            <p class="text-xs text-gray-500"><%= @partnership.partner_owner.code %></p>
          </div>

          <div>
            <p class="text-xs text-gray-500">Client</p>
            <p class="text-sm font-medium text-gray-900"><%= @partnership.partner_client.name %></p>
            <p class="text-xs text-gray-500"><%= @partnership.partner_client.code %></p>
          </div>
        </div>

        <p class="text-xs text-gray-500">Partnership companies cannot be changed after creation</p>
      </div>

      <!-- Active Status -->
      <div class="flex items-start">
        <div class="flex items-center h-5">
          <%= f.check_box :active, class: "h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 rounded" %>
        </div>
        <div class="ml-3">
          <%= f.label :active, "Active", class: "font-medium text-gray-700" %>
          <p class="text-sm text-gray-500">Enable or disable this partnership relationship</p>
        </div>
      </div>

      <!-- Actions -->
      <div class="flex items-center justify-end gap-3 pt-4 border-t border-gray-200">
        <%= link_to "Cancel", admin_company_partnerships_path(@company), class: "px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors" %>
        <%= f.submit "Update Partnership", class: "px-4 py-2 text-sm font-medium text-white bg-blue-600 border border-transparent rounded-lg hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors" %>
      </div>
    <% end %>
  <% end %>
</div>
