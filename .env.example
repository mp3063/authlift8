# Authlift Configuration
AUTHLIFT_URL=http://localhost:3231
AUTHLIFT_CLIENT_ID=
AUTHLIFT_CLIENT_SECRET=

# OAuth Provider Credentials
# Google OAuth2
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook OAuth2
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# GitHub OAuth2
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Twitter OAuth2
TWITTER_API_KEY=
TWITTER_API_SECRET=

# Database Configuration
DATABASE_URL=postgresql://localhost/authlift8_development

# Redis (for sessions, cache, and Solid Queue)
REDIS_URL=redis://localhost:6379/0

# Security Configuration
# =======================

# Rack::Attack - Rate Limiting Configuration
# -------------------------------------------
# Development: Disabled by default (uncomment line below to enable for testing)
# Production: Always enabled (cannot be disabled - critical security protection)
# Test: Always disabled (automatic)
# RACK_ATTACK_ENABLED=true

# Whitelisted IPs (comma-separated list of IPs that bypass ALL rate limits)
# Use for internal services, monitoring tools, or trusted partners
# WARNING: These IPs bypass ALL security rate limits - use sparingly!
# Example: WHITELISTED_IPS=10.0.1.5,192.168.1.100
WHITELISTED_IPS=

# Blocked IPs (comma-separated list of IPs to permanently block)
# Use for known malicious IPs or attackers identified through monitoring
# Example: BLOCKED_IPS=192.168.1.100,10.0.0.50
BLOCKED_IPS=

# Rails Environment
RAILS_ENV=development
RAILS_LOG_LEVEL=debug

# Allowed Origins for CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:3232,http://localhost:3233,http://localhost:3234

# Application Settings
RAILS_MAX_THREADS=5
WEB_CONCURRENCY=1

# Email Configuration (for Devise)
SMTP_ADDRESS=smtp.gmail.com
SMTP_PORT=587
SMTP_DOMAIN=yourdomain.com
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS_AUTO=true

# Default sender email
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# ReCAPTCHA (optional)
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Application Port
PORT=3231
